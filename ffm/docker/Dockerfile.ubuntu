# Ubuntu's own python3, which has libpython built into the executable (no shared libpython).
# Checks that Python-first finds the Python API in the running process. See ffm/docker/run.sh.
FROM docker.io/library/eclipse-temurin:25-jdk AS jdk
FROM docker.io/library/ubuntu:24.04
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-numpy \
    && rm -rf /var/lib/apt/lists/*
COPY --from=jdk /opt/java/openjdk /opt/java/openjdk
ENV JAVA_HOME=/opt/java/openjdk
WORKDIR /src
